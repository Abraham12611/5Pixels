# Supabase project credentials (required)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Payment provider switch: 'bachs' (default), or 'whop' / 'creem' as
# emergency rollbacks. Polar and Dodo integrations have been removed.
PAYMENT_PROVIDER=bachs

# Bachs (server only). BACHS_API_KEY is sk_sandbox_* for preview/dev and
# sk_live_* for production — going live is a key + environment swap.
# BACHS_WEBHOOK_SECRET is the endpoint signing secret shown when the
# webhook destination is created (POST /api/webhooks/bachs).
BACHS_API_KEY=
BACHS_WEBHOOK_SECRET=
# 'sandbox' targets sandbox-api.bachs.io and selects the
# bachs_product_id_sandbox plan metadata keys. Unset = live.
BACHS_ENVIRONMENT=sandbox
# Optional: JSON map of plan slug → Bachs product (prod_*) id. Overrides
# plans.metadata product ids when set.
# BACHS_PRODUCT_ID_OVERRIDES={"monthly-pro":"prod_...","weekly-starter":"prod_..."}
BACHS_PRODUCT_ID_OVERRIDES=

# Whop (server only) — retained for rollback only.
WHOP_API_KEY=
WHOP_ACCOUNT_ID=
WHOP_WEBHOOK_SECRET=
# 'sandbox' selects the whop_variant_id_sandbox plan metadata keys.
WHOP_ENVIRONMENT=
# Optional: JSON map of plan slug → Whop variant (plan_*) id. Overrides
# plans.metadata variant ids when set.
# WHOP_VARIANT_ID_OVERRIDES={"monthly-pro":"plan_...","weekly-starter":"plan_..."}
WHOP_VARIANT_ID_OVERRIDES=

# Creem (server only) — retained for rollback + the optional moderation API.
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
# CREEM_PRODUCT_ID_OVERRIDES={"pro-monthly":"prod_...","weekly-starter":"prod_..."}
CREEM_PRODUCT_ID_OVERRIDES=
# Creem Moderation API is paused while Creem billing is inactive; set to
# 'true' to re-enable content screening.
CREEM_MODERATION_ENABLED=false

# Bearer token for cron endpoints (GET /api/cron/credit-drip, /api/cron/teaser-sweep)
CRON_SECRET=

# GrowSurf referral program.
# Server only: API key + webhook secret (Program Editor > Options >
# Webhooks) must never reach the client. GROWSURF_CAMPAIGN_ID scopes the
# REST client and webhook events to our campaign (whr2c0).
# NEXT_PUBLIC_GROWSURF_CAMPAIGN_ID drives the universal <head> snippet —
# it is a public identifier, safe to expose. Defaults to whr2c0.
# GROWSURF_REFERRAL_HOLD_DAYS (1–90) only applies when the program's
# referral trigger is "Sign Up + Qualifying Action"; under the saved
# "Sign Up" trigger, referral credit is already given at signup and the
# code falls back to the immediate local grant.
GROWSURF_API_KEY=
GROWSURF_CAMPAIGN_ID=whr2c0
GROWSURF_WEBHOOK_SECRET=
GROWSURF_REFERRAL_HOLD_DAYS=
NEXT_PUBLIC_GROWSURF_CAMPAIGN_ID=whr2c0

# fal.ai server-side API key for the image generation provider (server only)
FAL_KEY=
# fal.ai key with billing:usage:read scope for the Billing Events
# reconciliation cron (BILLING or FULL key preset). Falls back to FAL_KEY
# if that key already carries the scope.
FAL_BILLING_KEY=
