# Supabase project credentials (required)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Payment provider switch: 'polar' (default) or 'dodo'
PAYMENT_PROVIDER=polar

# Polar (server only; POLAR_SERVER is 'sandbox' or 'production')
POLAR_ACCESS_TOKEN=
POLAR_SERVER=sandbox
POLAR_WEBHOOK_SECRET=
POLAR_ORGANIZATION_ID=c5ba80bb-4f7a-4348-9ead-0ebe7ac28068

# Dodo Payments (server only; set to 'test_mode' or 'live_mode')
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode

# Bearer token for cron endpoints (GET /api/cron/credit-drip, /api/cron/teaser-sweep)
CRON_SECRET=

# GrowSurf referral program (server only — never expose to the client).
# All three come from the GrowSurf dashboard: campaign id + API key +
# webhook secret (Program Editor > Options > Webhooks).
# GROWSURF_REFERRAL_HOLD_DAYS (1–90) parks the referrer reward in a
# pending_hold state until the refund window passes; absent/0 = grant
# immediately at first payment.
GROWSURF_API_KEY=
GROWSURF_CAMPAIGN_ID=
GROWSURF_WEBHOOK_SECRET=
GROWSURF_REFERRAL_HOLD_DAYS=

# fal.ai server-side API key for the image generation provider (server only)
FAL_KEY=
