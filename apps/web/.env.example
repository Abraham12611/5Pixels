# Supabase project credentials (required)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Payment provider switch: 'polar' (default) or 'dodo'
PAYMENT_PROVIDER=polar

# Polar (server only; POLAR_SERVER is 'sandbox' or 'production')
POLAR_ACCESS_TOKEN=
POLAR_SERVER=sandbox
POLAR_WEBHOOK_SECRET=
POLAR_ORGANIZATION_ID=c5ba80bb-4f7a-4348-9ead-0ebe7ac28068

# Dodo Payments (server only; set to 'test_mode' or 'live_mode')
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode

# Bearer token for the credit-drip cron endpoint (GET /api/cron/credit-drip)
CRON_SECRET=

# fal.ai server-side API key for the image generation provider (server only)
FAL_KEY=
