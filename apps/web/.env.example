# Supabase project credentials (required)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Payment provider switch: 'bachs' (default), or 'whop' / 'creem' as
# emergency rollbacks. Polar and Dodo integrations have been removed.
PAYMENT_PROVIDER=bachs

# Bachs (server only). BACHS_API_KEY is sk_sandbox_* for preview/dev and
# sk_live_* for production — going live is a key + environment swap.
# BACHS_WEBHOOK_SECRET is the endpoint signing secret shown when the
# webhook destination is created (POST /api/webhooks/bachs).
BACHS_API_KEY=
BACHS_WEBHOOK_SECRET=
# 'sandbox' targets sandbox-api.bachs.io and selects the
# bachs_product_id_sandbox plan metadata keys. Unset = live.
BACHS_ENVIRONMENT=sandbox
# Optional: JSON map of plan slug → Bachs product (prod_*) id. Overrides
# plans.metadata product ids when set.
# BACHS_PRODUCT_ID_OVERRIDES={"monthly-pro":"prod_...","weekly-starter":"prod_..."}
BACHS_PRODUCT_ID_OVERRIDES=

# Whop (server only) — retained for rollback only.
WHOP_API_KEY=
WHOP_ACCOUNT_ID=
WHOP_WEBHOOK_SECRET=
# 'sandbox' selects the whop_variant_id_sandbox plan metadata keys.
WHOP_ENVIRONMENT=
# Optional: JSON map of plan slug → Whop variant (plan_*) id. Overrides
# plans.metadata variant ids when set.
# WHOP_VARIANT_ID_OVERRIDES={"monthly-pro":"plan_...","weekly-starter":"plan_..."}
WHOP_VARIANT_ID_OVERRIDES=

# Creem (server only) — retained for rollback + the optional moderation API.
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
# CREEM_PRODUCT_ID_OVERRIDES={"pro-monthly":"prod_...","weekly-starter":"prod_..."}
CREEM_PRODUCT_ID_OVERRIDES=
# Creem Moderation API is paused while Creem billing is inactive; set to
# 'true' to re-enable content screening.
CREEM_MODERATION_ENABLED=false

# Server-only multi-image consumer release switch (#178/#179). OFF by default.
# Set true only after provider pipeline (#193), admin publish eligibility, and
# cross-feature QA (#185) have passed on the deployed stack. Admin capability
# alone must never enable public multi-image input UX.
PRESET_MULTI_INPUT_ENABLED=false

# Server-side release gate for user-edited preset prompts (#183). Kept OFF
# until written provider/merchant approval (#173), the policy update (#172),
# and owner signoff — UI toggles alone cannot enable it. Requires a valid
# OPENAI_API_KEY; custom prompts fail closed without configured moderation.
PRESET_USER_PROMPT_ENABLED=false

# OpenAI Moderation API (server only) — screens user-entered generation
# text (the normalized custom prompt plus free-text option fields) through
# omni-moderation-latest before quoting/credits/provider. Fail-closed:
# no key = every prompt request rejected.
OPENAI_API_KEY=
# Optional private-gateway override; defaults to https://api.openai.com.
# OPENAI_BASE_URL=
# OPENAI_MODERATION_URL=

# Bearer token for all cron endpoints (GET /api/cron/credit-drip,
# /api/cron/teaser-sweep, /api/cron/billing-reconcile — hourly,
# /api/cron/pricing-sync, /api/cron/referral-hold-release).
# Vercel injects it automatically on scheduled runs; required.
CRON_SECRET=

# Articles (#129): comma-separated HTTPS hosts allowed as external media
# embeds in article documents. Empty = no external media; internal uploads
# always go through the article-media pipeline regardless.
NEXT_PUBLIC_ARTICLE_MEDIA_HOSTS=

# Referrer 30% payment-share refund-window hold, in days (1–90). The reward
# stays pending_hold until the window elapses; a refund inside it cancels
# the reward before credits exist. Default 14 when unset; 0 disables.
REFERRAL_PAYMENT_SHARE_HOLD_DAYS=14

# Preset Factory MCP (#272): backend selection for the /api/mcp tool layer.
# 'direct' (default) calls Engineer A's service in-process with the caller's
# token-scoped client. 'fixture' returns clearly-simulated canned responses
# for local development — it is REFUSED in production/preview environments.
PRESET_FACTORY_BACKEND=direct

# REQUIRED for any MCP write: HMAC secret signing owner write-approval
# tokens (minted at /admin/preset-factory/approve). Generate with:
#   openssl rand -hex 32
# Unset → all write tools fail closed; reads still work.
PRESET_FACTORY_APPROVAL_SECRET=

# REQUIRED in production: comma-separated OAuth client ids allowed to call
# /api/mcp — the token's `client_id` claim (Supabase OAuth 2.1 server) must
# match one, so ordinary web-session bearer tokens can't drive this surface.
# Unset in production = every request fails closed. Unset locally = dev pass.
PRESET_FACTORY_MCP_CLIENT_IDS=

# Optional: comma-separated extra Origins allowed to POST to /api/mcp
# (same-origin is always allowed; absent Origin = non-browser client).
PRESET_FACTORY_MCP_ALLOWED_ORIGINS=

# fal.ai server-side API key for the image generation provider (server only)
FAL_KEY=
# fal.ai key with billing:usage:read scope for the Billing Events
# reconciliation cron (BILLING or FULL key preset). Falls back to FAL_KEY
# if that key already carries the scope.
FAL_BILLING_KEY=
